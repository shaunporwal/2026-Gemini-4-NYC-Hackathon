{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "title": "Digital Twin Map v1",
  "description": "See docs/MAP_SCHEMA.md. Everything physical is a character in `rows`. Horizontal units are cells, vertical units are metres, yaw is compass degrees (0 = north = -y).",
  "type": "object",
  "required": [
    "version",
    "name",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "cellSize": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.5
    },
    "wallHeight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 3
    },
    "legend": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/cellType"
      },
      "description": "Extra or overriding characters, merged over the default legend."
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The grid: one character per cell, all rows the same length. Default legend: '#' wall, '.' floor, 'E' exit, 'T' table, 'C' chair, 'P' person, 'D' door, ' ' void."
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/zone"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/camera"
      }
    }
  },
  "$defs": {
    "cellType": {
      "enum": [
        "void",
        "floor",
        "wall",
        "door",
        "exit",
        "table",
        "chair",
        "person"
      ]
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "zone": {
      "allOf": [
        {
          "$ref": "#/$defs/rect"
        }
      ],
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": true,
        "y": true,
        "w": true,
        "h": true
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": [
        "id",
        "name",
        "x",
        "y",
        "height",
        "yaw",
        "pitch",
        "fov",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
